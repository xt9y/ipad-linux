# J407 first-boot configuration fragment.
# Keep first boot self-contained: UART, storage, USB, PCIe and diagnostics must
# not depend on modules stored on hardware that is itself still being brought up.
CONFIG_ARCH_APPLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Apple co-processor infrastructure required by the ANS2 NVMe driver.
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y

# Apple DMA/IOMMU and ANS2 storage path.
CONFIG_APPLE_DART=y
CONFIG_NVME_APPLE=y

# J407 radio is a BCM4387C2 combo module behind T8103 PCIe port00.
# CFG80211 is tristate-limited by RFKILL, so RFKILL must also be built-in or
# olddefconfig will legally reduce CFG80211/BRCMFMAC back to modules.
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BT=y
CONFIG_BT_HCIBCM4377=y
CONFIG_FW_LOADER=y

# J407 public ADT independently verifies one T8103 USB DRD/DART/ATC path.
# Keep the transport stack built-in so USB enumeration is observable from the
# initramfs before any persistent root filesystem exists.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_I2C=y
CONFIG_I2C_APPLE=y
CONFIG_TYPEC_TPS6598X=y

# m1n1 can preserve iBoot's scanout and patch /chosen/framebuffer. SimpleDRM
# turns that firmware framebuffer into an early on-device console without
# claiming native J407 DCP support.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
