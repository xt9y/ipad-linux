# J407 first-boot configuration fragment.
# Keep the first milestone focused on CPU/AIC/timer/UART + external initramfs.
CONFIG_ARCH_APPLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# These are intentionally built in now so the next storage milestone does not
# depend on module loading from a root filesystem.
CONFIG_APPLE_DART=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y

# Keep PCIe available for later J407 Wi-Fi/board-device work.
CONFIG_PCIE_APPLE=y
