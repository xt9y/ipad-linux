# J407 first-boot configuration fragment.
# Keep the first milestone focused on built-in diagnostics: UART, storage and
# PCIe enumeration must work before a persistent root filesystem exists.
CONFIG_ARCH_APPLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Apple co-processor infrastructure required by the ANS2 NVMe driver.
# Keep these built-in: early storage bring-up must not depend on modules from
# the very storage device we are trying to discover.
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y

# Apple DMA/IOMMU and ANS2 storage path.
CONFIG_APPLE_DART=y
CONFIG_NVME_APPLE=y

# J407 radio is a BCM4387C2 combo module behind T8103 PCIe port00.
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BT=y
CONFIG_BT_HCIBCM4377=y

# The drivers select FW_LOADER themselves; keep it explicit because physical
# Wi-Fi/BT enablement will eventually require Apple/Broadcom firmware files in
# the initramfs or persistent root filesystem.
CONFIG_FW_LOADER=y
