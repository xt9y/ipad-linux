From: ipad-linux J407 bring-up <noreply@example.invalid>
Subject: [PATCH] pinctrl: apple: support explicit hardware IRQ groups

Apple GPIO controllers expose up to seven hardware interrupt groups. Existing
DTs list parent interrupts for groups 0..N-1, and the driver relies on that
identity mapping both for register selection and handler state recovery.

J407 has Apple GPIO instances with the same register layout but only hardware
IRQ groups 4, 5 and 6 wired to useful parent interrupts. Add an optional
apple,irq-groups property mapping each listed parent interrupt to its hardware
group. Preserve the existing sequential mapping when the property is absent.

Store explicit per-parent handler data instead of reconstructing the controller
pointer from the group number. This keeps non-zero group mappings safe and
leaves existing device trees behaviorally unchanged.

---
diff --git a/Documentation/devicetree/bindings/pinctrl/apple,pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/apple,pinctrl.yaml
--- a/Documentation/devicetree/bindings/pinctrl/apple,pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/apple,pinctrl.yaml
@@ -59,6 +59,19 @@
       number in ascending order.
     minItems: 1
     maxItems: 7
+
+  apple,irq-groups:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 7
+    uniqueItems: true
+    items:
+      minimum: 0
+      maximum: 6
+    description:
+      Hardware interrupt group corresponding to each entry in interrupts.
+      If absent, groups are assigned sequentially starting at zero, matching
+      the behavior expected by existing Apple device trees.
 
   interrupt-controller: true
 
diff --git a/drivers/pinctrl/pinctrl-apple-gpio.c b/drivers/pinctrl/pinctrl-apple-gpio.c
--- a/drivers/pinctrl/pinctrl-apple-gpio.c
+++ b/drivers/pinctrl/pinctrl-apple-gpio.c
@@ -30,6 +30,13 @@
 #include "core.h"
 #include "pinmux.h"
 
+struct apple_gpio_pinctrl;
+
+struct apple_gpio_irqgrp {
+	struct apple_gpio_pinctrl *pctl;
+	u8 group;
+};
+
 struct apple_gpio_pinctrl {
 	struct device *dev;
 	struct pinctrl_dev *pctldev;
@@ -39,7 +46,7 @@
 
 	struct pinctrl_desc pinctrl_desc;
 	struct gpio_chip gpio_chip;
-	u8 irqgrps[];
+	struct apple_gpio_irqgrp irqgrps[];
 };
 
 #define REG_GPIO(x)          (4 * (x))
@@ -311,9 +318,10 @@
 {
 	struct gpio_chip *chip = irq_data_get_irq_chip_data(data);
 	struct apple_gpio_pinctrl *pctl = gpiochip_get_data(chip);
+	u8 irqgrp = pctl->irqgrps[0].group;
 
 	apple_gpio_set_reg(pctl, data->hwirq, REG_GPIOx_GRP,
-			   FIELD_PREP(REG_GPIOx_GRP, 0));
+			   FIELD_PREP(REG_GPIOx_GRP, irqgrp));
 
 	apple_gpio_direction_input(chip, data->hwirq);
 	apple_gpio_irq_unmask(data);
@@ -342,18 +350,17 @@
 static void apple_gpio_irq_handler(struct irq_desc *desc)
 {
 	struct irq_chip *chip = irq_desc_get_chip(desc);
-	u8 *grpp = irq_desc_get_handler_data(desc);
-	struct apple_gpio_pinctrl *pctl;
+	struct apple_gpio_irqgrp *irqgrp = irq_desc_get_handler_data(desc);
+	struct apple_gpio_pinctrl *pctl = irqgrp->pctl;
 	unsigned int pinh, pinl;
 	unsigned long pending;
 	struct gpio_chip *gc;
 
-	pctl = container_of(grpp - *grpp, typeof(*pctl), irqgrps[0]);
 	gc = &pctl->gpio_chip;
 
 	chained_irq_enter(chip, desc);
 	for (pinh = 0; pinh < gc->ngpio; pinh += 32) {
-		pending = readl_relaxed(pctl->base + REG_IRQ(*grpp, pinh));
+		pending = readl_relaxed(pctl->base + REG_IRQ(irqgrp->group, pinh));
 		for_each_set_bit(pinl, &pending, 32)
 			generic_handle_domain_irq(gc->irq.domain, pinh + pinl);
 	}
@@ -392,7 +399,18 @@
 	pctl->gpio_chip.parent = pctl->dev;
 
 	if (girq->num_parents) {
-		int i;
+		bool has_irqgrps = of_property_present(pctl->dev->of_node,
+						 "apple,irq-groups");
+		int i, j;
+
+		if (has_irqgrps) {
+			ret = of_property_count_u32_elems(pctl->dev->of_node,
+							  "apple,irq-groups");
+			if (ret != girq->num_parents) {
+				ret = -EINVAL;
+				goto out_free_irq_data;
+			}
+		}
 
 		gpio_irq_chip_set_chip(girq, &apple_gpio_irqchip);
 		girq->parent_handler = apple_gpio_irq_handler;
@@ -407,12 +425,35 @@
 		}
 
 		for (i = 0; i < girq->num_parents; i++) {
-			ret = platform_get_irq(to_platform_device(pctl->dev), i);
-			if (ret < 0)
+			u32 irqgrp = i;
+			int parent_irq;
+
+			parent_irq = platform_get_irq(to_platform_device(pctl->dev), i);
+			if (parent_irq < 0) {
+				ret = parent_irq;
 				goto out_free_irq_data;
+			}
 
-			girq->parents[i] = ret;
-			pctl->irqgrps[i] = i;
+			if (has_irqgrps) {
+				ret = of_property_read_u32_index(pctl->dev->of_node,
+								 "apple,irq-groups", i,
+								 &irqgrp);
+				if (ret || irqgrp > 6) {
+					ret = -EINVAL;
+					goto out_free_irq_data;
+				}
+
+				for (j = 0; j < i; j++) {
+					if (pctl->irqgrps[j].group == irqgrp) {
+						ret = -EINVAL;
+						goto out_free_irq_data;
+					}
+				}
+			}
+
+			girq->parents[i] = parent_irq;
+			pctl->irqgrps[i].pctl = pctl;
+			pctl->irqgrps[i].group = irqgrp;
 			irq_data[i] = &pctl->irqgrps[i];
 		}
 
